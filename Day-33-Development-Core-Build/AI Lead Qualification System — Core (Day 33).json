    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nlet score = 0;\nconst reasons = [];\n\nif (item.company) { score += 20; reasons.push('Company name provided (+20)'); }\n\nconst titleKeywords = ['ceo','founder','owner','director','vp','vice president','head','president','manager','lead'];\nconst title = (item.title || '').toLowerCase();\nif (titleKeywords.some(k => title.includes(k))) { score += 15; reasons.push('Decision-maker title (+15)'); }\n\nif (item.phone) { score += 15; reasons.push('Phone number provided (+15)'); }\n\nconst freeDomains = ['gmail.com','yahoo.com','hotmail.com','outlook.com','icloud.com'];\nconst domain = item.email && item.email.includes('@') ? item.email.split('@')[1] : '';\nif (domain && !freeDomains.includes(domain)) { score += 20; reasons.push('Business email domain (+20)'); }\nelse if (domain && freeDomains.includes(domain)) { score -= 20; reasons.push('Free/personal email domain (-20)'); }\n\nif (item.message && item.message.length > 25) { score += 15; reasons.push('Detailed message provided (+15)'); }\n\nscore = Math.max(0, Math.min(100, score));\n\nlet tier;\nif (score >= 70) tier = 'Hot';\nelse if (score >= 40) tier = 'Warm';\nelse tier = 'Cold';\n\nreturn {\n  json: {\n    ...item,\n    rule_based_score: score,\n    preliminary_tier: tier,\n    rule_reasoning: reasons.join('; '),\n    qualification_status: 'Pending AI Review',\n  }\n};"
      },
