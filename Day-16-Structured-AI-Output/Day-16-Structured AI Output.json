    {
      "parameters": {
        "jsCode": "const requiredFields = [\n  'category',\n  'priority',\n  'sentiment',\n  'department',\n  'summary'\n];\n\nconst data = $json;\n\nlet isValid = true;\nlet errorMessage = '';\n\nfor (const field of requiredFields) {\n  if (\n    data[field] === undefined ||\n    data[field] === null ||\n    typeof data[field] !== 'string' ||\n    data[field].trim() === ''\n  ) {\n    isValid = false;\n    errorMessage = `Missing or invalid field: ${field}`;\n    break;\n  }\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      isValid,\n      errorMessage\n    }\n  }\n];"
      },
