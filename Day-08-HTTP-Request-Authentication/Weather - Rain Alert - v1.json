      "typeVersion": 1.2,
      "position": [
        -656,
        192
      ]
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "34.3302"
            },
            {
              "name": "longitude",
              "value": "73.1968"
            },
            {
              "name": "current_weather",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "064f6ba8-1dd8-4d4a-9ccf-f859e3ed5dc8",
      "name": "Get Weather Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -432,
        192
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1a1a1a1-0000-0000-0000-000000000001",
              "name": "weathercode",
              "value": "={{ $json.current_weather.weathercode }}",
              "type": "number"
            },
            {
              "id": "a1a1a1a1-0000-0000-0000-000000000002",
              "name": "temperature",
              "value": "={{ $json.current_weather.temperature }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "e1c16b2e-4c4e-4807-9741-055b2bfedd17",
      "name": "Extract Weather Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -224,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "b1b1b1b1-0000-0000-0000-000000000001",
              "leftValue": "={{ $json.weathercode }}",
              "rightValue": 51,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "b1b1b1b1-0000-0000-0000-000000000002",
              "leftValue": "={{ $json.weathercode }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3d88369d-ee38-43d0-a958-0e1f6a1fbf20",
      "name": "Is It Raining",
