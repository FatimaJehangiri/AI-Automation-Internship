    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an email classification assistant for a business inbox.\n\nClassify the following email into EXACTLY ONE of these categories:\n- Sales\n- Support\n- Complaint\n- Invoice\n- Spam\n- General\n\nRules:\n- Respond with ONLY the category name, nothing else. No punctuation, no explanation, no extra words.\n- If the email is a purchase inquiry, quote request, or pricing question, use \"Sales\".\n- If the email is a technical question or help request about an existing product/service, use \"Support\".\n- If the email expresses dissatisfaction, frustration, or a formal grievance, use \"Complaint\".\n- If the email is about billing, payments, or invoices, use \"Invoice\".\n- If the email looks like an unsolicited promotion, phishing attempt, or irrelevant bulk email, use \"Spam\".\n- If it doesn't clearly fit any category above, use \"General\".\n\nEmail details:\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\nBody: {{ $json.body }}\n\nCategory:"
      },
      "id": "dc4dea2c-6929-49b1-a3ad-24b4a1b9e568",
      "name": "Classify Email (LLM Chain)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -656,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const allowed = [\"Sales\", \"Support\", \"Complaint\", \"Invoice\", \"Spam\", \"General\"];\n\n// Basic LLM Chain output shape varies by n8n version:\n// older versions -> { text: \"Sales\" }\n// newer versions -> { response: { text: \"Sales\" } }\nconst item = $input.item.json;\nlet raw = \"\";\nif (typeof item.text === \"string\") {\n  raw = item.text;\n} else if (item.response && typeof item.response.text === \"string\") {\n  raw = item.response.text;\n} else if (item.response && typeof item.response === \"string\") {\n  raw = item.response;\n} else if (typeof item.output === \"string\") {\n  raw = item.output;\n}\n\nraw = (raw || \"\").toString().trim();\n\n// Clean up: strip punctuation/quotes/markdown the model might add\nconst cleaned = raw.replace(/[\\*\\.\\\"'`]/g, \"\").trim();\n\n// Case-insensitive match against allowed categories\nlet category = allowed.find(c => c.toLowerCase() === cleaned.toLowerCase());\n\n// Fallback if the model returned something unexpected\nif (!category) {\n  category = \"General\";\n}\n\nconst upstream = $(\"Normalize Email Data\").item.json;\n\nreturn {\n  json: {\n    from: upstream.from,\n    subject: upstream.subject,\n    body: upstream.body,\n    receivedAt: upstream.receivedAt,\n    category: category,\n    rawModelOutput: raw\n  }\n};"
      },
