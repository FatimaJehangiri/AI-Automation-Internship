    {
      "parameters": {
        "jsCode": "// Validates required fields, email format, and budget type\nconst raw = $input.item.json;\n   const item = raw.body ? raw.body : raw;\n\nconst requiredFields = ['name', 'email', 'company', 'service', 'budget'];\nconst errors = [];\n\nfor (const field of requiredFields) {\n  const value = item[field];\n  if (value === undefined || value === null || value.toString().trim() === '') {\n    errors.push(`Missing required field: ${field}`);\n  }\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (item.email && !emailRegex.test(item.email)) {\n  errors.push('Invalid email format');\n}\n\nconst budgetNum = Number(item.budget);\nif (item.budget !== undefined && item.budget !== null && item.budget !== '' && isNaN(budgetNum)) {\n  errors.push('Budget must be a number');\n}\n\nreturn {\n  json: {\n    name: item.name,\n    email: item.email,\n    company: item.company,\n    service: item.service,\n    budget: isNaN(budgetNum) ? item.budget : budgetNum,\n    isValid: errors.length === 0,\n    validationErrors: errors\n  }\n};"
      },
      "id": "35ea3972-86b8-4b05-9848-da6d6432238d",
