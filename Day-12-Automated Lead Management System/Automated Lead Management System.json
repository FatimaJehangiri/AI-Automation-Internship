    {
      "parameters": {
        "jsCode": "// Scores the lead and assigns a priority tier\nconst lead = $input.item.json;\nlet score = 0;\n\n// --- Budget scoring ---\nconst budget = Number(lead.budget) || 0;\nif (budget >= 10000) score += 3;\nelse if (budget >= 5000) score += 2;\nelse if (budget >= 1000) score += 1;\n\n// --- Service type scoring ---\n// Edit this list to match the services you actually offer\nconst highValueServices = ['ai agent', 'automation system', 'custom integration', 'enterprise', 'chatbot'];\nconst serviceLower = (lead.service || '').toString().toLowerCase();\nif (highValueServices.some(s => serviceLower.includes(s))) {\n  score += 2;\n} else if (serviceLower.trim() !== '') {\n  score += 1;\n}\n\n// --- Company provided ---\nif (lead.company && lead.company.toString().trim() !== '') {\n  score += 1;\n}\n\n// --- Priority tier ---\nlet priority = 'Low';\nif (score >= 5) priority = 'High';\nelse if (score >= 3) priority = 'Medium';\n\nreturn {\n  json: {\n    ...lead,\n    leadScore: score,\n    priority\n  }\n};"
      },
