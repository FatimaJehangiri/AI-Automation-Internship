      "parameters": {
        "jsCode": "const original = $('Validate Lead Fields').first().json;\nconst matches = $input.all();\nconst found = matches.length > 0 && matches[0].json && matches[0].json.id;\n\nreturn [{\n  json: {\n    ...original,\n    duplicateFound: !!found,\n    existingId: found ? matches[0].json.id : null,\n  }\n}];"
      },
