    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n// Final decision: trust AI tier when AI ran successfully, otherwise the rule-based tier is already copied in.\nconst final_score = item.ai_used ? item.ai_score : item.rule_based_score;\nconst final_tier = item.ai_used ? item.ai_tier : item.preliminary_tier;\nreturn {\n  json: {\n    ...item,\n    final_score,\n    final_tier,\n    qualification_status: item.ai_used ? 'Qualified - AI Reviewed' : 'Qualified - Rule Based (AI Unavailable)',\n    notify_required: final_tier === 'Hot',\n  }\n};"
      },
