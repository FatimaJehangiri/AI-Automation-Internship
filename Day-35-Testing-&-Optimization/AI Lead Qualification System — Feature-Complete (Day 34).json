    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst prompt = `You are a B2B sales qualification assistant. Score this lead using judgement that goes beyond simple keyword rules (consider intent, seniority, message quality, and fit signals together).\\n\\nLead data:\\nName: ${item.name}\\nEmail: ${item.email}\\nCompany: ${item.company}\\nTitle: ${item.title}\\nPhone: ${item.phone || 'not provided'}\\nMessage: \\\"${item.message || ''}\\\"\\nSource: ${item.source}\\n\\nRule-based pre-score (for reference only, you may agree or disagree): ${item.rule_based_score}/100 (${item.preliminary_tier}). Reasoning: ${item.rule_reasoning}\\n\\nRespond with ONLY a single JSON object, no markdown, no commentary, matching exactly this shape:\\n{\\\"ai_score\\\": <integer 0-100>, \\\"ai_tier\\\": \\\"Hot\\\"|\\\"Warm\\\"|\\\"Cold\\\", \\\"ai_reasoning\\\": \\\"<one or two sentences>\\\", \\\"recommended_action\\\": \\\"<one short sentence, e.g. next step for sales>\\\", \\\"red_flags\\\": [\\\"<short flag>\\\", ...]}`;\n\nreturn {\n  json: {\n    ...item,\n    ai_prompt: prompt,\n  }\n};"
      },
      "id": "ad597974-e94a-4a40-9529-6ce5be9d22f6",
      "name": "AI - Build Scoring Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        16
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"openai/gpt-oss-120b\" , temperature: 0.2, max_tokens: 400, response_format: { type: \"json_object\" }, messages: [ { role: \"system\", content: \"You are a strict JSON API. Always return only valid JSON, matching the requested shape exactly. Never include markdown fences or extra text.\" }, { role: \"user\", content: $json.ai_prompt } ] }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "5fe1e4a3-a0d5-4b50-a688-63ad96c8e002",
      "name": "AI - Groq Structured Scoring",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        16
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Yrb1jLizxWrGrWjm",
          "name": "Header Auth account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Success branch: Groq responded. Parse + validate its structured output.\nconst item = $json;\nlet ai = null;\nlet fallbackReason = null;\ntry {\n  const content = item.choices[0].message.content;\n  const parsed = JSON.parse(content);\n  const validTiers = ['Hot', 'Warm', 'Cold'];\n  const scoreOk = typeof parsed.ai_score === 'number' && parsed.ai_score >= 0 && parsed.ai_score <= 100;\n  const tierOk = validTiers.includes(parsed.ai_tier);\n  if (!scoreOk || !tierOk) {\n    throw new Error('AI output failed schema validation (score/tier out of range or missing)');\n  }\n  ai = {\n    ai_score: Math.round(parsed.ai_score),\n    ai_tier: parsed.ai_tier,\n    ai_reasoning: (parsed.ai_reasoning || '').toString().slice(0, 500),\n    recommended_action: (parsed.recommended_action || '').toString().slice(0, 300),\n    red_flags: Array.isArray(parsed.red_flags) ? parsed.red_flags.slice(0, 10) : [],\n  };\n} catch (err) {\n  fallbackReason = 'AI response invalid/unparseable: ' + err.message;\n}\n\nconst original = $('AI - Build Scoring Prompt').first().json;\ndelete original.ai_prompt;\n\nif (ai) {\n  return { json: { ...original, ...ai, ai_used: true, ai_fallback_reason: null } };\n}\nreturn {\n  json: {\n    ...original,\n    ai_score: original.rule_based_score,\n    ai_tier: original.preliminary_tier,\n    ai_reasoning: 'AI scoring unavailable — using rule-based score.',\n    recommended_action: 'Review manually.',\n    red_flags: [],\n    ai_used: false,\n    ai_fallback_reason: fallbackReason,\n  }\n};"
      },
      "id": "b3a5acaf-d3be-4acc-948e-fc45306cee1b",
      "name": "AI - Process & Validate Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "// Error branch: the Groq HTTP call itself failed (timeout, 4xx/5xx, rate limit, network).\nconst original = $('AI - Build Scoring Prompt').first().json;\ndelete original.ai_prompt;\nreturn {\n  json: {\n    ...original,\n    ai_score: original.rule_based_score,\n    ai_tier: original.preliminary_tier,\n    ai_reasoning: 'AI scoring unavailable — using rule-based score.',\n    recommended_action: 'Review manually.',\n    red_flags: [],\n    ai_used: false,\n    ai_fallback_reason: 'AI API call failed: ' + ($json.error || $json.message || 'unknown error'),\n  }\n};"
      },
      "id": "a8697629-ca98-4ca7-98ef-8cee2cadd446",
      "name": "AI - Fallback on API Failure",
