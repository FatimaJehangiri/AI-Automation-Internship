    {
      "parameters": {
        "jsCode": "// Candidate Screening Automation - Day 6 Assignment\n// Runs validation + screening rules + categorization in one place\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  const name = (data.Name || '').trim();\n  const email = (data.Email || '').trim();\n  const degree = (data.Degree || '').trim();\n  const skills = (data.Skills || '').trim();\n  const experienceRaw = (data.Experience || '').toString().trim();\n  const availability = (data.Availability || '').trim();\n\n  const experience = parseFloat(experienceRaw) || 0;\n\n  const isValid = name !== '' && email !== '' && degree !== '';\n\n  let category = '';\n  let reason = '';\n\n  if (!isValid) {\n    category = 'Not Eligible';\n    reason = 'Missing required field(s): Name, Email, or Degree';\n  } else {\n    const degreeMatch = /computer|ai|software|artificial intelligence/i.test(degree);\n    const availabilityMatch = /immediate|1 week|one week/i.test(availability);\n    const hasExperience = experience >= 1;\n\n    if (degreeMatch && hasExperience && availabilityMatch) {\n      category = 'Shortlisted';\n      reason = 'Meets all screening criteria';\n    } else if (degreeMatch && hasExperience) {\n      category = 'Needs Review';\n      reason = 'Meets degree and experience, but availability does not match';\n    } else if (degreeMatch || hasExperience) {\n      category = 'Needs Review';\n      reason = 'Partially matches criteria — manual review required';\n    } else {\n      category = 'Not Eligible';\n      reason = 'Does not meet degree or experience requirements';\n    }\n  }\n\n  results.push({\n    json: {\n      Name: name,\n      Email: email,\n      Degree: degree,\n      Skills: skills,\n      Experience: experienceRaw,\n      Availability: availability,\n      isValid: isValid,\n      Category: category,\n      Reason: reason\n    }\n  });\n}\n\nreturn results;"
      },
