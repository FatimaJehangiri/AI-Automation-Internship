    {
      "parameters": {
        "jsCode": "// 6. Extract Candidate Information (rule-based pre-processing)\nconst item = $input.first().json;\nconst rawText = item.text || item.resumeText || '';\n\nfunction extractYearsExperience(text) {\n  const matches = text.match(/(\\d+)\\+?\\s*(years|yrs)\\s*(of)?\\s*experience/i);\n  return matches ? parseInt(matches[1]) : null;\n}\n\nfunction extractEducation(text) {\n  const degrees = ['PhD','Master','MSc','MS','Bachelor','BSc','BS','BBA','MBA','Diploma'];\n  const found = degrees.filter(d => new RegExp(d, 'i').test(text));\n  return found.length ? found.join(', ') : 'Not specified';\n}\n\nfunction extractContact(text) {\n  const emailMatch = text.match(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/);\n  const phoneMatch = text.match(/(\\+?\\d[\\d\\s-]{7,}\\d)/);\n  return {\n    email: emailMatch ? emailMatch[0] : null,\n    phone: phoneMatch ? phoneMatch[0] : null\n  };\n}\n\nreturn [{\n  json: {\n    ...($items('2. Store Candidate Data')[0]?.json || {}),\n    resumeRawText: rawText.slice(0, 8000),\n    extractedYearsExperience: extractYearsExperience(rawText),\n    extractedEducation: extractEducation(rawText),\n    extractedContact: extractContact(rawText)\n  }\n}];"
      },
      "id": "29c8308f-0e78-48fa-88e4-622dd5cb90eb",
      "name": "6. Extract Candidate Information",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1424,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// 8. Rule-Based + AI Assessment merge\nconst stored = $('2. Store Candidate Data').first().json;\nconst extracted = $('6. Extract Candidate Information').first().json;\nlet ai;\ntry {\n  const raw = $input.first().json.choices?.[0]?.message?.content || '{}';\n  ai = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  ai = { skills: [], aiScore: 0, aiRecommendation: 'Review Further', reason: 'AI response could not be parsed; flagged for manual review.', strengths: [], gaps: [] };\n}\n\n// --- Rule-based scoring (business rules layered on top of AI) ---\nlet ruleScore = 0;\nconst requiredSkills = ['communication']; // customize per role, or pull from a config sheet\nconst yearsExp = ai.yearsExperience ?? extracted.extractedYearsExperience ?? 0;\n\nif (yearsExp >= 5) ruleScore += 30;\nelse if (yearsExp >= 2) ruleScore += 20;\nelse if (yearsExp >= 1) ruleScore += 10;\n\nconst skillsLower = (ai.skills || []).map(s => String(s).toLowerCase());\nconst matchedRequired = requiredSkills.filter(rs => skillsLower.some(s => s.includes(rs)));\nruleScore += matchedRequired.length * 10;\n\nif (extracted.extractedEducation && extracted.extractedEducation !== 'Not specified') ruleScore += 10;\n\nruleScore = Math.min(ruleScore, 50); // rule engine caps at 50\n\n// --- Weighted combined score: 70% AI, 30% rule engine ---\nconst aiScore = Number(ai.aiScore) || 0;\nconst finalScore = Math.round((aiScore * 0.7) + (ruleScore * (100/50) * 0.3));\n\nlet recommendation = 'Review Further';\nif (finalScore >= 75) recommendation = 'Shortlist';\nelse if (finalScore < 40) recommendation = 'Reject';\n\nreturn [{\n  json: {\n    candidate: {\n      candidateId: stored.candidateId,\n      name: stored.name,\n      email: stored.email,\n      phone: stored.phone,\n      jobRole: stored.jobRole\n    },\n    skills: ai.skills || [],\n    score: finalScore,\n    aiScore: aiScore,\n    ruleScore: ruleScore,\n    recommendation: recommendation,\n    aiRecommendation: ai.aiRecommendation || 'Review Further',\n    reason: ai.reason || 'No reason provided by AI.',\n    strengths: ai.strengths || [],\n    gaps: ai.gaps || []\n  }\n}];"
      },
      "id": "b609bd32-b0c1-4bbc-9222-d5f1833ffb8f",
      "name": "8. Rule-Based + AI Assessment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        128
      ]
