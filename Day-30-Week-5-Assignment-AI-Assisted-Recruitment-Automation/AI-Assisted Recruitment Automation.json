    {
      "parameters": {
        "sendTo": "ema664130@gmail.com",
        "subject": "=Human Review Needed: {{ $json.candidate.name }} — {{ $json.candidate.jobRole }} (AI score: {{ $json.score }})",
        "message": "=<h2>Candidate Review Required</h2>\n<p><b>Name:</b> {{ $json.candidate.name }}<br>\n<b>Role Applied:</b> {{ $json.candidate.jobRole }}<br>\n<b>Email:</b> {{ $json.candidate.email }}</p>\n<p><b>AI Score:</b> {{ $json.score }}/100<br>\n<b>Skills:</b> {{ $json.skills.join(', ') }}<br>\n<b>AI Recommendation:</b> {{ $json.aiRecommendation }}<br>\n<b>Reason:</b> {{ $json.reason }}</p>\n<p><b>Strengths:</b> {{ $json.strengths.join(', ') }}<br>\n<b>Gaps:</b> {{ $json.gaps.join(', ') }}</p>\n<p>This is an AI-generated assessment only. Please make the final call:</p>\n<p>\n<a href=\"{{ $execution.resumeUrl }}?decision=shortlist\" style=\"padding:10px 20px;background:#2ecc71;color:white;text-decoration:none;border-radius:4px;\">✅ Shortlist</a>\n&nbsp;&nbsp;\n<a href=\"{{ $execution.resumeUrl }}?decision=reject\" style=\"padding:10px 20px;background:#e74c3c;color:white;text-decoration:none;border-radius:4px;\">❌ Reject</a>\n</p>",
        "options": {
          "appendAttribution": false
        }
      },
