      "id": "7b96e3fa-7895-4187-9560-13add7438b1c",
      "name": "5b. Extract Text From Resume PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        -1680,
        32
