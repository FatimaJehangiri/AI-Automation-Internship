    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst name = String(body.name ?? '').trim();\nconst email = String(body.email ?? '').trim().toLowerCase();\nconst company = String(body.company ?? '').trim();\nconst city = String(body.city ?? '').trim();\nconst interest = String(body.interest ?? '').trim();\n\nif (!name || !email || !company || !city || !interest) {\n  throw new Error('Validation failed: name, email, company, city and interest are required.');\n}\nif (!/^\\S+@\\S+\\.\\S+$/.test(email)) {\n  throw new Error('Validation failed: invalid email address.');\n}\n\nreturn [{ json: { name, email, company, city, interest, receivedAt: new Date().toISOString(), status: 'New' } }];"
      },
      "id": "1a14e284-593f-42e8-a38a-f89a39a6f022",
